<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <PackageId>NinjaCats.Zebra</PackageId>
    <Version>0.0.1-preview.1</Version>
    <Authors>NinjaCats</Authors>
    <Description>Zebra. Placeholder release</Description>
    <PackageTags>fsharp;cli;parsing</PackageTags>
    <AssemblyName>NinjaCats.Zebra</AssemblyName>
    <RootNamespace>NinjaCats.Zebra</RootNamespace>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/itsninjacats/Zebra</PackageProjectUrl>
    <RepositoryUrl>https://github.com/itsninjacats/Zebra</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Update="FSharp.Core" Version="8.0.100" />
    
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <Compile Include="Library.fs" />
  </ItemGroup>

</Project>
